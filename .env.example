# URL del backend en producción
# En desarrollo se usa el proxy de Vite configurado en vite.config.ts
# Dejar vacío en desarrollo (usa /api con el proxy automáticamente)
VITE_API_URL=https://turnopro-backend-7594.onrender.com

# URL base del frontend (usada para generar links en WhatsApp y emails)
VITE_APP_URL=http://localhost:5173

# Número de WhatsApp (con código de país, sin +) para el CTA de la landing en "/".
# Si se deja vacío, el botón cae a un link a /login en vez de romper.
VITE_SUPPORT_WHATSAPP=5491100000000
